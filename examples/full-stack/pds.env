# Local AT Protocol PDS (distribution center) — demo values only
PDS_HOSTNAME=pds.test
PDS_PORT=2583
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOB_UPLOAD_LIMIT=52428800
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_SERVICE_HANDLE_DOMAINS=.pds.test
PDS_INVITE_REQUIRED=false
PDS_DISABLE_SSRF_PROTECTION=true
PDS_DEV_MODE=true
PDS_RATE_LIMITS_ENABLED=false
LOG_ENABLED=1
LOG_LEVEL=info

# Secrets are generated by scripts/gen-pds-secrets.sh into pds.secrets.env
