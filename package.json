{
  "name": "open-firmware",
  "private": true,
  "version": "0.1.0",
  "description": "Production AT Protocol firmware, container, and deployment distribution for IoT and edge",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @open-firmware/iot-camera-emulator run test:e2e",
    "typecheck": "pnpm -r --if-present run build && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.0.5"
  }
}
