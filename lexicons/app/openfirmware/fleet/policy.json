{
  "lexicon": 1,
  "id": "app.openfirmware.fleet.policy",
  "defs": {
    "main": {
      "type": "record",
      "description": "Default fleet policy for auto-update, size limits, and windows.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["updatedAt"],
        "properties": {
          "autoUpdate": {
            "type": "boolean",
            "default": true
          },
          "maxImageBytes": {
            "type": "integer",
            "minimum": 0
          },
          "defaultChannel": {
            "type": "string",
            "knownValues": ["stable", "beta", "dev"]
          },
          "defaultServiceWindow": {
            "type": "ref",
            "ref": "app.openfirmware.fleet.updateOffer#serviceWindow"
          },
          "requireOemSignature": {
            "type": "boolean",
            "default": false
          },
          "trustedOemKeys": {
            "type": "array",
            "items": { "type": "string", "maxLength": 64 },
            "maxLength": 16
          },
          "maxChannelAgeSec": {
            "type": "integer",
            "minimum": 0
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
