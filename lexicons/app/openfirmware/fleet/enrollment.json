{
  "lexicon": 1,
  "id": "app.openfirmware.fleet.enrollment",
  "defs": {
    "main": {
      "type": "record",
      "description": "Fleet-side enrollment of a device. rkey is the device fingerprint.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["fingerprint", "product", "enrolledAt"],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "deviceDid": {
            "type": "string",
            "format": "did"
          },
          "product": {
            "type": "string",
            "maxLength": 128
          },
          "role": {
            "type": "string",
            "knownValues": ["iot", "sidekar", "edge"]
          },
          "labels": {
            "type": "array",
            "items": { "type": "string", "maxLength": 64 },
            "maxLength": 32
          },
          "channel": {
            "type": "string",
            "knownValues": ["stable", "beta", "dev"]
          },
          "autoUpdate": {
            "type": "boolean",
            "default": true
          },
          "enrolledAt": {
            "type": "string",
            "format": "datetime"
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
