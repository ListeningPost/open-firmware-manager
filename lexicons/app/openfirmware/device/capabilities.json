{
  "lexicon": 1,
  "id": "app.openfirmware.device.capabilities",
  "defs": {
    "main": {
      "type": "record",
      "description": "What artifact kinds this node can apply. rkey is the device fingerprint in the fleet repo.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["kinds", "runtime", "updatedAt"],
        "properties": {
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "knownValues": [
                "firmware",
                "package",
                "container",
                "deployment",
                "bundle"
              ]
            },
            "maxLength": 16
          },
          "runtime": {
            "type": "string",
            "knownValues": ["iot", "sidekar", "edge"]
          },
          "arch": {
            "type": "string",
            "maxLength": 64
          },
          "maxImageBytes": {
            "type": "integer",
            "minimum": 0
          },
          "docker": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
