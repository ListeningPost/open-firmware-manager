{
  "lexicon": 1,
  "id": "app.openfirmware.device.joinRequest",
  "defs": {
    "main": {
      "type": "record",
      "description": "Optional public join-request mirror. Primary join path is the private control plane; never put secrets or recovery material here.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["product", "fingerprint", "ed25519PublicKey", "createdAt", "status"],
        "properties": {
          "product": { "type": "string", "maxLength": 128 },
          "fingerprint": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "ed25519PublicKey": { "type": "string", "maxLength": 64 },
          "createdAt": { "type": "string", "format": "datetime" },
          "status": {
            "type": "string",
            "knownValues": ["pending", "approved", "denied"]
          }
        }
      }
    }
  }
}
