{
  "lexicon": 1,
  "id": "app.openfirmware.firmware.defs",
  "defs": {
    "sha256": {
      "type": "string",
      "description": "Lowercase hex SHA-256 digest of bytes.",
      "minLength": 64,
      "maxLength": 64
    },
    "part": {
      "type": "object",
      "description": "One content-addressed slice of a release payload. Blob lives on the author's PDS; sha256 is the application digest of those bytes.",
      "required": ["seq", "blob", "sha256", "byteOffset", "byteLength"],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "blob": {
          "type": "blob",
          "accept": ["*/*"],
          "maxSize": 52428800
        },
        "sha256": {
          "type": "ref",
          "ref": "#sha256"
        },
        "byteOffset": {
          "type": "integer",
          "minimum": 0
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "oemSignature": {
      "type": "object",
      "description": "Detached OEM signature over the canonical release tuple, independent of PDS session keys.",
      "required": ["alg", "publicKey", "sig"],
      "properties": {
        "alg": {
          "type": "string",
          "knownValues": ["ed25519"]
        },
        "publicKey": {
          "type": "string",
          "description": "Raw 32-byte Ed25519 public key, base64url",
          "maxLength": 64
        },
        "sig": {
          "type": "string",
          "description": "Signature bytes, base64url",
          "maxLength": 128
        },
        "keyId": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  }
}
