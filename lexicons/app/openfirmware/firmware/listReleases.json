{
  "lexicon": 1,
  "id": "app.openfirmware.firmware.listReleases",
  "defs": {
    "main": {
      "type": "query",
      "description": "AppView catalog of indexed releases. Cursor-paginated. Not a trust root.",
      "parameters": {
        "type": "params",
        "properties": {
          "product": { "type": "string", "maxLength": 128 },
          "channel": {
            "type": "string",
            "knownValues": ["stable", "beta", "dev"]
          },
          "repo": { "type": "string", "format": "at-identifier" },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["releases"],
          "properties": {
            "releases": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#releaseView"
              }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    },
    "releaseView": {
      "type": "object",
      "required": ["uri", "cid", "product", "version", "channel"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "repo": { "type": "string", "format": "did" },
        "product": { "type": "string" },
        "version": { "type": "string" },
        "channel": { "type": "string" }
      }
    }
  }
}
