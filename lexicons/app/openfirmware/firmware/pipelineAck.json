{
  "lexicon": 1,
  "id": "app.openfirmware.firmware.pipelineAck",
  "defs": {
    "main": {
      "type": "record",
      "description": "Pipeline/CI acknowledgment linked to a release. Independent attesters should write this in their own repo; consumers may be configured to require those DIDs.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["release", "stage", "result", "createdAt", "actor"],
        "properties": {
          "release": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "stage": {
            "type": "string",
            "knownValues": [
              "build",
              "test",
              "lint",
              "security-scan",
              "sign",
              "promote",
              "custom"
            ]
          },
          "stageId": {
            "type": "string",
            "maxLength": 128
          },
          "result": {
            "type": "string",
            "knownValues": ["passed", "failed", "skipped"]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "runUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "commit": {
            "type": "string",
            "maxLength": 64
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "actor": {
            "type": "string",
            "format": "did"
          }
        }
      }
    }
  }
}
