{
  "lexicon": 1,
  "id": "app.openfirmware.firmware.releaseSeal",
  "defs": {
    "main": {
      "type": "record",
      "description": "Optional seal asserting a release is fully published. Strong-ref the immutable release CID.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["release", "partCount", "imageSha256", "createdAt"],
        "properties": {
          "release": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "partCount": {
            "type": "integer",
            "minimum": 0
          },
          "imageSha256": {
            "type": "ref",
            "ref": "app.openfirmware.firmware.defs#sha256"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
