{
  "lexicon": 1,
  "id": "app.openfirmware.firmware.getRelease",
  "defs": {
    "main": {
      "type": "query",
      "description": "Hydrated AppView view of one release URI. Clients must still verify against the author PDS.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid", "repo"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" },
            "repo": { "type": "string", "format": "did" },
            "product": { "type": "string" },
            "version": { "type": "string" },
            "channel": { "type": "string" },
            "imageSha256": { "type": "string" },
            "imageSize": { "type": "integer" }
          }
        }
      }
    }
  }
}
