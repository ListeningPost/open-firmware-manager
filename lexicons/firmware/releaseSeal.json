{
  "lexicon": 1,
  "id": "app.openfirmware.firmware.releaseSeal",
  "defs": {
    "main": {
      "type": "record",
      "description": "Optional seal asserting a release chain is fully published and ready to install.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["release", "chunkCount", "imageSha256", "createdAt"],
        "properties": {
          "release": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "chunkCount": {
            "type": "integer",
            "minimum": 0
          },
          "imageSha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
